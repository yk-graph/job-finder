{
  "name": "job-finder",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "volta": {
    "node": "22.20.0",
    "pnpm": "10.18.2"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "prettier": "^3.6.2"
  }
}
